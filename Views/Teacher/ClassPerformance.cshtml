@{
    ViewBag.Title = "Class Performance";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="dashboard-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="card-title mb-0">Class Performance</h2>
        <div class="d-flex gap-2">
            <select class="form-select w-auto">
                <option>Mathematics</option>
                <option>Science</option>
                <option>English</option>
                <option>History</option>
            </select>
            <select class="form-select w-auto">
                <option>All Students</option>
                <option>Group A</option>
                <option>Group B</option>
            </select>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-8">
            <div class="card h-100">
                <div class="card-header bg-mint text-white">
                    <h5 class="mb-0">Performance Overview</h5>
                </div>
                <div class="card-body">
                    <canvas id="performanceChart" height="250"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-header bg-mint text-white">
                    <h5 class="mb-0">Class Statistics</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <span>Average Score:</span>
                        <strong>78.4%</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Highest Score:</span>
                        <strong>96%</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Lowest Score:</span>
                        <strong>58%</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span>Completion Rate:</span>
                        <strong>92%</strong>
                    </div>
                    <hr>
                    <h6 class="text-center mb-3">Grade Distribution</h6>
                    <div class="progress-stacked mb-2">
                        <div class="progress" role="progressbar" style="width: 25%">
                            <div class="progress-bar bg-success">A (25%)</div>
                        </div>
                        <div class="progress" role="progressbar" style="width: 40%">
                            <div class="progress-bar bg-info">B (40%)</div>
                        </div>
                        <div class="progress" role="progressbar" style="width: 20%">
                            <div class="progress-bar bg-warning">C (20%)</div>
                        </div>
                        <div class="progress" role="progressbar" style="width: 15%">
                            <div class="progress-bar bg-danger">D/F (15%)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-mint text-white">
            <h5 class="mb-0">Student Performance</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Student</th>
                            <th>Quizzes</th>
                            <th>Assignments</th>
                            <th>Avg. Score</th>
                            <th>Progress</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>John Smith</td>
                            <td>8/10</td>
                            <td>12/12</td>
                            <td>86%</td>
                            <td>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar bg-success" style="width: 92%"></div>
                                </div>
                            </td>
                            <td><span class="badge bg-success">Excellent</span></td>
                        </tr>
                        <tr>
                            <td>Emma Johnson</td>
                            <td>7/10</td>
                            <td>10/12</td>
                            <td>78%</td>
                            <td>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar bg-info" style="width: 75%"></div>
                                </div>
                            </td>
                            <td><span class="badge bg-info">Good</span></td>
                        </tr>
                        <tr>
                            <td>Michael Brown</td>
                            <td>5/10</td>
                            <td>8/12</td>
                            <td>65%</td>
                            <td>
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar bg-warning" style="width: 55%"></div>
                                </div>
                            </td>
                            <td><span class="badge bg-warning">Needs Help</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Initialize performance chart
        const ctx = document.getElementById('performanceChart').getContext('2d');
        const chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May'],
                datasets: [{
                    label: 'Class Average',
                    data: [72, 75, 74, 78, 82],
                    borderColor: '#48c9b0',
                    backgroundColor: 'rgba(72, 201, 176, 0.1)',
                    tension: 0.3,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'top',
                    }
                },
                scales: {
                    y: {
                        min: 50,
                        max: 100,
                        title: {
                            display: true,
                            text: 'Percentage'
                        }
                    }
                }
            }
        });
    </script>
}

<style>
    .bg-mint {
        background-color: var(--mint-medium) !important;
    }

    .bg-success {
        background-color: var(--mint-medium) !important;
    }

    .progress-bar {
        background-color: var(--mint-medium);
    }
</style>