@model List<Brain_Mint.Models.QuizAttempt>
@{
    ViewBag.Title = "Quiz Submissions";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
    var quiz = ViewBag.Quiz as Brain_Mint.Models.Quiz;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h3>Submissions for: @quiz.Title</h3>
                    <a href="@Url.Action("QuizManagement", "Teacher")" class="btn btn-secondary btn-sm">
                        <i class="fas fa-arrow-left"></i> Back to Quizzes
                    </a>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Student</th>
                                        <th>Start Time</th>
                                        <th>End Time</th>
                                        <th>Status</th>
                                        <th>Score</th>
                                        <th>Grading Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var attempt in Model)
                                    {
                                        <tr>
                                            <td>@attempt.Student.Name</td>
                                            <td>@attempt.StartTime.ToString("MMM dd, yyyy hh:mm tt")</td>
                                            <td>@(attempt.EndTime?.ToString("MMM dd, yyyy hh:mm tt") ?? "Not completed")</td>
                                            <td>
                                                <span class="badge bg-@(attempt.Status == "Completed" ? "success" : "warning")">
                                                    @attempt.Status
                                                </span>
                                            </td>
                                            <td>
                                                @if (attempt.TotalScore.HasValue && attempt.MaximumScore.HasValue)
                                                {
                                                    <text>@attempt.TotalScore / @attempt.MaximumScore</text>
                                                    <br />
                                                    <small class="text-muted">
                                                        @((attempt.TotalScore.Value / (double)attempt.MaximumScore.Value * 100).ToString("F1"))%
                                                    </small>
                                                }
                                                else
                                                {
                                                    <text>N/A</text>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-@(attempt.GradingStatus == "Graded" ? "success" :
                                                                     attempt.GradingStatus == "PendingReview" ? "warning" : "secondary")">
                                                    @attempt.GradingStatus
                                                </span>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("ReviewQuizAttempt", "Teacher", new { id = attempt.Id })"
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye"></i> Review
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <div class="text-muted">
                                <i class="fas fa-inbox fa-3x mb-3"></i>
                                <h5>No submissions yet</h5>
                                <p>Students haven't taken this quiz yet.</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>