@model Brain_Mint.Models.QuizQuestion
@{
    ViewBag.Title = "Edit Question";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="mb-0">Edit Question</h3>
                    <a href="@Url.Action("QuizEdit", "Teacher", new { id = Model.QuizId })" class="btn btn-secondary btn-sm">
                        <i class="fas fa-arrow-left"></i> Back to Quiz
                    </a>
                </div>

                <div class="card-body">
                    @if (!string.IsNullOrEmpty(ViewBag.Error))
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            @ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @using (Html.BeginForm("EditQuestion", "Teacher", FormMethod.Post))
                    {
                        @Html.HiddenFor(m => m.Id)
                        @Html.HiddenFor(m => m.QuestionOrder)
                        @Html.HiddenFor(m => m.QuizId)

                        <!-- Question Type Display -->
                        <div class="form-group mb-3">
                            <label class="form-label">Question Type</label>
                            <div class="form-control-plaintext">
                                @if (Model.QuestionType == "ShortAnswer" || string.IsNullOrEmpty(Model.OptionA))
                                {
                                    <span class="badge bg-info">Short Answer</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">Multiple Choice</span>
                                }
                            </div>
                        </div>

                        <!-- Question Text -->
                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.QuestionText, new { @class = "form-label" })
                            @Html.TextAreaFor(m => m.QuestionText, new
                            {
                                @class = "form-control",
                                rows = 3,
                                placeholder = "Enter your question here..."
                            })
                            @Html.ValidationMessageFor(m => m.QuestionText, "", new { @class = "text-danger" })
                        </div>

                        <!-- Multiple Choice or Short Answer Fields -->
                        if (Model.QuestionType == "MultipleChoice" || !string.IsNullOrEmpty(Model.OptionA))
                        {
                            <!-- Multiple Choice Options -->
                            <h5 class="mb-3">Answer Options</h5>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.OptionA, "Option A", new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.OptionA, new { @class = "form-control", placeholder = "Enter option A" })
                                    @Html.ValidationMessageFor(m => m.OptionA, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.OptionB, "Option B", new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.OptionB, new { @class = "form-control", placeholder = "Enter option B" })
                                    @Html.ValidationMessageFor(m => m.OptionB, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.OptionC, "Option C", new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.OptionC, new { @class = "form-control", placeholder = "Enter option C" })
                                    @Html.ValidationMessageFor(m => m.OptionC, "", new { @class = "text-danger" })
                                </div>
                                <div class="col-md-6">
                                    @Html.LabelFor(m => m.OptionD, "Option D", new { @class = "form-label" })
                                    @Html.TextBoxFor(m => m.OptionD, new { @class = "form-control", placeholder = "Enter option D" })
                                    @Html.ValidationMessageFor(m => m.OptionD, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="form-group mb-3">
                                @Html.LabelFor(m => m.CorrectAnswer, "Correct Answer", new { @class = "form-label" })
                                @Html.DropDownListFor(m => m.CorrectAnswer, new SelectList(new[] {
                                    new { Value = "", Text = "Select the correct answer" },
                                    new { Value = "A", Text = "A" },
                                    new { Value = "B", Text = "B" },
                                    new { Value = "C", Text = "C" },
                                    new { Value = "D", Text = "D" }
                                }, "Value", "Text", Model.CorrectAnswer),
                                    new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.CorrectAnswer, "", new { @class = "text-danger" })
                            </div>
                        }
                        else
                        {
                            <!-- Short Answer Section -->
                            <div class="form-group mb-3">
                                @Html.LabelFor(m => m.CorrectAnswer, "Sample/Expected Answer", new { @class = "form-label" })
                                @Html.TextAreaFor(m => m.CorrectAnswer, new
                                {
                                    @class = "form-control",
                                    rows = 2,
                                    placeholder = "Enter a sample correct answer or key points (optional)"
                                })
                                <small class="form-text text-muted">
                                    This will help you when grading. Students won't see this.
                                </small>
                                @Html.ValidationMessageFor(m => m.CorrectAnswer, "", new { @class = "text-danger" })
                            </div>
                        }

                        <!-- Current Preview -->
                        <div class="card mb-3">
                            <div class="card-header">
                                <h6 class="mb-0">Current Question Preview</h6>
                            </div>
                            <div class="card-body">
                                <h6>Question: @Model.QuestionText</h6>

                                @if (Model.QuestionType == "MultipleChoice" || !string.IsNullOrEmpty(Model.OptionA))
                                {
                                    <div class="mt-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" disabled>
                                            <label class="form-check-label">A) @Model.OptionA</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" disabled>
                                            <label class="form-check-label">B) @Model.OptionB</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" disabled>
                                            <label class="form-check-label">C) @Model.OptionC</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" disabled>
                                            <label class="form-check-label">D) @Model.OptionD</label>
                                        </div>
                                        @if (!string.IsNullOrEmpty(Model.CorrectAnswer))
                                        {
                                            <div class="mt-2">
                                                <small class="text-success">
                                                    <strong>Correct Answer: @Model.CorrectAnswer</strong>
                                                </small>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="mt-3">
                                        <textarea class="form-control" rows="3" placeholder="Student will type here..." disabled></textarea>
                                        @if (!string.IsNullOrEmpty(Model.CorrectAnswer))
                                        {
                                            <div class="mt-2">
                                                <small class="text-info">
                                                    <strong>Expected Answer: </strong>@Model.CorrectAnswer
                                                </small>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Update Question
                            </button>
                            <a href="@Url.Action("QuizEdit", "Teacher", new { id = Model.QuizId })"
                               class="btn btn-secondary">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>