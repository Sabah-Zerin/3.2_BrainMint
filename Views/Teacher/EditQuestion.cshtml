@model Brain_Mint.Models.QuizQuestion
@{
    ViewBag.Title = "Edit Question";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h3>Edit Question</h3>
                    <a href="@Url.Action("QuizEdit", "Teacher", new { id = Model.QuizId })" class="btn btn-secondary btn-sm">
                        Back to Quiz
                    </a>
                </div>

                <div class="card-body">
                    @if (!string.IsNullOrEmpty(ViewBag.Error))
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            @ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form method="post" action="@Url.Action("EditQuestion", "Teacher")">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="questionOrder" value="@Model.QuestionOrder" />

                        <!-- Question Type Display -->
                        <div class="form-group mb-3">
                            <label class="form-label">Question Type</label>
                            <div class="form-control-plaintext">
                                @if (string.IsNullOrEmpty(Model.OptionA))
                                {
                                    <span class="badge badge-info">Short Answer</span>
                                }
                                else
                                {
                                    <span class="badge badge-primary">Multiple Choice</span>
                                }
                            </div>
                        </div>

                        <!-- Question Text -->
                        <div class="form-group mb-3">
                            <label for="questionText" class="form-label">Question <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="questionText" name="questionText" rows="3"
                                      placeholder="Enter your question here..." required>@Model.QuestionText</textarea>
                        </div>

                        <!-- Multiple Choice Options -->
                        @if (!string.IsNullOrEmpty(Model.OptionA))
                        {
                            <div id="multipleChoiceOptions">
                                <h5 class="mb-3">Answer Options</h5>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label for="optionA" class="form-label">Option A <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="optionA" name="optionA"
                                               placeholder="Enter option A" value="@Model.OptionA" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label for="optionB" class="form-label">Option B <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="optionB" name="optionB"
                                               placeholder="Enter option B" value="@Model.OptionB" required />
                                    </div>
                                </div>

                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label for="optionC" class="form-label">Option C <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="optionC" name="optionC"
                                               placeholder="Enter option C" value="@Model.OptionC" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label for="optionD" class="form-label">Option D <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="optionD" name="optionD"
                                               placeholder="Enter option D" value="@Model.OptionD" required />
                                    </div>
                                </div>

                                <div class="form-group mb-3">
                                    <label for="correctAnswer" class="form-label">Correct Answer <span class="text-danger">*</span></label>
                                    <select class="form-control" id="correctAnswer" name="correctAnswer" required>
                                        <option value="">Select the correct answer</option>
                                        <option value="A" @(Model.CorrectAnswer == "A" ? "selected" : "")>A</option>
                                        <option value="B" @(Model.CorrectAnswer == "B" ? "selected" : "")>B</option>
                                        <option value="C" @(Model.CorrectAnswer == "C" ? "selected" : "")>C</option>
                                        <option value="D" @(Model.CorrectAnswer == "D" ? "selected" : "")>D</option>
                                    </select>
                                </div>
                            </div>
                        }
                        else
                        {
                            <!-- Short Answer Section -->
                            <div id="shortAnswerSection">
                                <div class="form-group mb-3">
                                    <label for="correctAnswer" class="form-label">Sample/Expected Answer</label>
                                    <textarea class="form-control" id="correctAnswer" name="correctAnswer" rows="2"
                                              placeholder="Enter a sample correct answer or key points (optional)">@Model.CorrectAnswer</textarea>
                                    <small class="form-text text-muted">
                                        This will help you when grading. Students won't see this.
                                    </small>
                                </div>
                            </div>
                        }

                        <!-- Current Preview -->
                        <div class="card mb-3">
                            <div class="card-header">
                                <h6 class="mb-0">Current Question Preview</h6>
                            </div>
                            <div class="card-body">
                                <h6>Question: @Model.QuestionText</h6>

                                @if (!string.IsNullOrEmpty(Model.OptionA))
                                {
                                    <div class="mt-3">
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="preview" disabled>
                                            <label class="form-check-label">A) @Model.OptionA</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="preview" disabled>
                                            <label class="form-check-label">B) @Model.OptionB</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="preview" disabled>
                                            <label class="form-check-label">C) @Model.OptionC</label>
                                        </div>
                                        <div class="form-check">
                                            <input class="form-check-input" type="radio" name="preview" disabled>
                                            <label class="form-check-label">D) @Model.OptionD</label>
                                        </div>
                                        @if (!string.IsNullOrEmpty(Model.CorrectAnswer))
                                        {
                                            <div class="mt-2">
                                                <small class="text-success"><strong>Correct Answer: @Model.CorrectAnswer</strong></small>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="mt-3">
                                        <textarea class="form-control" rows="3" placeholder="Student will type their answer here..." disabled></textarea>
                                        @if (!string.IsNullOrEmpty(Model.CorrectAnswer))
                                        {
                                            <div class="mt-2">
                                                <small class="text-info"><strong>Expected Answer: </strong>@Model.CorrectAnswer</small>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">Update Question</button>
                            <a href="@Url.Action("QuizEdit", "Teacher", new { id = Model.QuizId })"
                               class="btn btn-secondary">Cancel</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .form-label {
        font-weight: 600;
        color: #495057;
    }

    .text-danger {
        color: #dc3545 !important;
    }

    .card-header {
        background-color: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
    }

    .form-check-label {
        margin-left: 0.25rem;
    }

    .btn {
        margin-right: 0.5rem;
    }

    textarea {
        resize: vertical;
    }

    .alert {
        border: none;
        border-radius: 8px;
    }

    .badge {
        font-size: 0.875em;
        padding: 0.5em 0.75em;
    }

    .form-control-plaintext {
        padding-top: 0.375rem;
        padding-bottom: 0.375rem;
        margin-bottom: 0;
        line-height: 1.5;
        color: #495057;
        background-color: transparent;
        border: solid transparent;
    }
</style>