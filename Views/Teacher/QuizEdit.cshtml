@model Brain_Mint.Models.Quiz
@{
    ViewBag.Title = "Edit Quiz";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h3>Edit Quiz: @Model.Title</h3>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="badge @(Model.Status == "Active" ? "bg-success" : Model.Status == "Draft" ? "bg-warning text-dark" : "bg-secondary")">
                            @Model.Status
                        </span>
                        <div>
                            @if (Model.Status == "Draft" && Model.Questions.Any())
                            {
                                <form method="post" action="@Url.Action("PublishQuiz", "Teacher")" class="d-inline">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Are you sure you want to publish this quiz?')">
                                        Publish Quiz
                                    </button>
                                </form>
                            }
                            <a href="@Url.Action("QuizManagement", "Teacher")" class="btn btn-secondary btn-sm">
                                Back to Quiz Management
                            </a>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <!-- Display Messages -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Quiz Details -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5>Quiz Information</h5>
                            <p><strong>Category:</strong> @Model.Category</p>
                            <p><strong>Difficulty:</strong> @Model.Difficulty</p>
                            <p><strong>Time Limit:</strong> @Model.TimeLimit minutes</p>
                            <p><strong>Total Questions:</strong> @Model.Questions.Count()</p>
                        </div>
                        <div class="col-md-6">
                            <h5>Description</h5>
                            <p>@(string.IsNullOrEmpty(Model.Description) ? "No description provided" : Model.Description)</p>
                            <p><strong>Created:</strong> @Model.CreatedDate.ToString("MMM dd, yyyy")</p>
                        </div>
                    </div>

                    <!-- Add Question Button -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5>Questions (@Model.Questions.Count())</h5>
                        @if (Model.Status == "Draft")
                        {
                            <a href="@Url.Action("AddQuestion", "Teacher", new { quizId = Model.Id })"
                               class="btn btn-primary btn-sm">
                                <i class="fas fa-plus"></i> Add Question
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-secondary btn-sm" disabled title="Cannot add questions to published quizzes">
                                <i class="fas fa-plus"></i> Add Question
                            </button>
                        }
                    </div>

                    <!-- Questions List -->
                    @if (Model.Questions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th width="5%">#</th>
                                        <th width="60%">Question</th>
                                        <th width="15%">Type</th>
                                        <th width="10%">Correct Answer</th>
                                        <th width="10%">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var question in Model.Questions.OrderBy(q => q.QuestionOrder))
                                    {
                                        <tr>
                                            <td>@question.QuestionOrder</td>
                                            <td>
                                                <div class="question-text">
                                                    @question.QuestionText
                                                </div>
                                                @if (question.QuestionType == "MultipleChoice" || !string.IsNullOrEmpty(question.OptionA))
                                                {
                                                    <small class="text-muted">
                                                        <div>A) @question.OptionA</div>
                                                        <div>B) @question.OptionB</div>
                                                        <div>C) @question.OptionC</div>
                                                        <div>D) @question.OptionD</div>
                                                    </small>
                                                }
                                            </td>
                                            <td>
                                                @if (question.QuestionType == "ShortAnswer" || string.IsNullOrEmpty(question.OptionA))
                                                {
                                                    <span class="badge bg-info">Short Answer</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary">Multiple Choice</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(question.CorrectAnswer))
                                                {
                                                    if (question.QuestionType == "MultipleChoice" && "ABCD".Contains(question.CorrectAnswer))
                                                    {
                                                        <span class="badge bg-success">@question.CorrectAnswer</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Sample Answer</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">None</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a href="@Url.Action("EditQuestion", "Teacher", new { id = question.Id })"
                                                       class="btn btn-outline-primary btn-sm">
                                                        Edit
                                                    </a>
                                                    <form method="post" action="@Url.Action("DeleteQuestion", "Teacher")" class="d-inline">
                                                        <input type="hidden" name="id" value="@question.Id" />
                                                        <button type="submit" class="btn btn-outline-danger btn-sm"
                                                                onclick="return confirm('Are you sure you want to delete this question?')">
                                                            Delete
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4">
                            <div class="text-muted">
                                <i class="fas fa-question-circle fa-3x mb-3"></i>
                                <h5>No questions added yet</h5>
                                <p>Start building your quiz by adding questions.</p>
                                <a href="@Url.Action("AddQuestion", "Teacher", new { quizId = Model.Id })"
                                   class="btn btn-primary">
                                    Add First Question
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .question-text {
        font-weight: 500;
        margin-bottom: 8px;
    }

    .badge {
        font-size: 0.75em;
    }

    .btn-group-sm .btn {
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
    }

    .table th {
        border-top: none;
        font-weight: 600;
        background-color: #f8f9fa;
    }

    .card-header {
        background-color: #fff;
        border-bottom: 1px solid #dee2e6;
    }
</style>