@model IEnumerable<Brain_Mint.Models.Quiz>

@{
    ViewBag.Title = "Quiz Management";
}

<h2>Quiz Management</h2>

@if (TempData["QuizCreateSuccess"] != null)
{
    <div class="alert alert-success">
        @TempData["QuizCreateSuccess"]
    </div>
}

<div class="row">
    <div class="col-md-12">
        <div class="pull-right" style="margin-bottom: 20px;">
            <a href="@Url.Action("QuizCreate", "Teacher")" class="btn btn-success">
                <i class="glyphicon glyphicon-plus"></i> New Quiz
            </a>
        </div>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-heading">
        <h3 class="panel-title">All Quizzes</h3>
    </div>
    <div class="panel-body">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Quiz Name</th>
                    <th>Category</th>
                    <th>Questions</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var quiz in Model)
                    {
                        <tr>
                            <td>@quiz.Title</td>
                            <td>@quiz.Category</td>
                            <td>@(quiz.Questions != null ? quiz.Questions.Count : 0)</td>
                            <td>
                                @if (quiz.Status == "Active")
                                {
                                    <span class="label label-success">@quiz.Status</span>
                                }
                                else if (quiz.Status == "Draft")
                                {
                                    <span class="label label-warning">@quiz.Status</span>
                                }
                                else
                                {
                                    <span class="label label-default">@quiz.Status</span>
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("QuizEdit", "Teacher", new { id = quiz.Id })" class="btn btn-sm btn-primary">
                                    <i class="glyphicon glyphicon-edit"></i> Edit
                                </a>
                                <button class="btn btn-sm btn-danger" onclick="deleteQuiz(@quiz.Id)">
                                    <i class="glyphicon glyphicon-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            <em>No quizzes created yet. Click "New Quiz" to create your first quiz!</em>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <a href="@Url.Action("TeacherDashboard", "Teacher")" class="btn btn-default">
            <i class="glyphicon glyphicon-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

<style>
    .pull-right {
        float: right;
    }

    .label {
        padding: 4px 8px;
        font-size: 11px;
        border-radius: 3px;
    }

    .label-success {
        background-color: #5cb85c;
    }

    .label-warning {
        background-color: #f0ad4e;
    }

    .label-default {
        background-color: #777;
    }

    .btn-sm {
        padding: 5px 10px;
        font-size: 12px;
        margin-right: 5px;
    }

    .text-center {
        text-align: center;
    }

    .text-muted {
        color: #777;
    }
</style>

<script>
    function deleteQuiz(quizId) {
        if (confirm('Are you sure you want to delete this quiz? This action cannot be undone.')) {
            alert('Delete functionality will be implemented later');
        }
    }
</script>