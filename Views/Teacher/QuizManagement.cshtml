@model List<Brain_Mint.Models.Quiz>
@{
    ViewBag.Title = "Quiz Management";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2>Quiz Management</h2>
                <a href="@Url.Action("QuizCreate", "Teacher")" class="btn btn-success">
                    <i class="fas fa-plus"></i> New Quiz
                </a>
            </div>

            <!-- Display Messages -->
            @if (TempData["QuizCreateSuccess"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["QuizCreateSuccess"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card">
                <div class="card-header">
                    <h4 class="mb-0">All Quizzes</h4>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-light">
                                    <tr>
                                        <th width="25%">Quiz Name</th>
                                        <th width="15%">Category</th>
                                        <th width="10%">Questions</th>
                                        <th width="10%">Status</th>
                                        <th width="15%">Created</th>
                                        <th width="25%">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var quiz in Model)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold">@quiz.Title</div>
                                                @if (!string.IsNullOrEmpty(quiz.Description))
                                                {
                                                    <small class="text-muted">@quiz.Description</small>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-secondary">@quiz.Category</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-info text-dark">
                                                    @(quiz.Questions?.Count ?? 0)
                                                </span>
                                            </td>
                                            <td>
                                                @if (quiz.Status == "Active")
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else if (quiz.Status == "Draft")
                                                {
                                                    <span class="badge bg-warning text-dark">Draft</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@quiz.Status</span>
                                                }
                                            </td>
                                            <td>
                                                <small>
                                                    @quiz.CreatedDate.ToString("MMM dd, yyyy")<br />
                                                    <span class="text-muted">@quiz.Difficulty</span> •
                                                    <span class="text-muted">@quiz.TimeLimit min</span>
                                                </small>
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a href="@Url.Action("QuizEdit", "Teacher", new { id = quiz.Id })"
                                                       class="btn btn-outline-primary" title="Edit Quiz & Questions">
                                                        <i class="fas fa-edit"></i> Edit
                                                    </a>

                                                    @if (quiz.Status == "Draft")
                                                    {
                                                        if (quiz.Questions?.Any() == true)
                                                        {
                                                            <form method="post" action="@Url.Action("PublishQuiz", "Teacher")" class="d-inline">
                                                                <input type="hidden" name="id" value="@quiz.Id" />
                                                                <button type="submit" class="btn btn-outline-success"
                                                                        onclick="return confirm('Are you sure you want to publish this quiz?')"
                                                                        title="Publish Quiz">
                                                                    <i class="fas fa-upload"></i> Publish
                                                                </button>
                                                            </form>
                                                        }
                                                        else
                                                        {
                                                            <button type="button" class="btn btn-outline-secondary" disabled
                                                                    title="Add questions before publishing">
                                                                <i class="fas fa-upload"></i> Publish
                                                            </button>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <!-- Eye button for viewing submissions -->
                                                        <a href="@Url.Action("QuizSubmissions", "Teacher", new { id = quiz.Id })"
                                                           class="btn btn-outline-info" title="View Submissions">
                                                            <i class="fas fa-eye"></i> Submissions
                                                        </a>
                                                    }

                                                    @if (quiz.Status == "Draft")
                                                    {
                                                        <a href="@Url.Action("AddQuestion", "Teacher", new { quizId = quiz.Id })"
                                                           class="btn btn-outline-info" title="Add Question">
                                                            <i class="fas fa-plus"></i> Question
                                                        </a>
                                                    }

                                                    <button type="button" class="btn btn-outline-danger"
                                                            onclick="deleteQuiz(@quiz.Id, '@quiz.Title')" title="Delete Quiz">
                                                        <i class="fas fa-trash"></i> Delete
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <div class="text-muted">
                                <i class="fas fa-clipboard-list fa-3x mb-3"></i>
                                <h5>No quizzes created yet</h5>
                                <p>Create your first quiz to get started.</p>
                                <a href="@Url.Action("QuizCreate", "Teacher")" class="btn btn-primary">
                                    <i class="fas fa-plus"></i> Create Your First Quiz
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-4">
                <a href="@Url.Action("TeacherDashboard", "Teacher")" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteQuizModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the quiz "<span id="quizNameToDelete"></span>"?</p>
                <p class="text-danger"><strong>This action cannot be undone and will delete all questions in this quiz.</strong></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form method="post" action="@Url.Action("DeleteQuiz", "Teacher")" class="d-inline">
                    <input type="hidden" name="id" id="quizIdToDelete" />
                    <button type="submit" class="btn btn-danger">Delete Quiz</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function deleteQuiz(quizId, quizTitle) {
        document.getElementById('quizIdToDelete').value = quizId;
        document.getElementById('quizNameToDelete').textContent = quizTitle;

        var deleteModal = new bootstrap.Modal(document.getElementById('deleteQuizModal'));
        deleteModal.show();
    }
</script>