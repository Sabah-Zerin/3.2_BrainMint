@model Brain_Mint.Models.User
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewBag.Title = "Student Profile";
}

<div class="dashboard-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="card-title mb-0">
            <i class="fas fa-user-circle me-2 text-mint"></i>My Profile
        </h2>
        <span class="badge bg-mint fs-6">Student Account</span>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Profile Information Card -->
    <div class="card mb-4">
        <div class="card-header bg-mint text-white">
            <h5 class="mb-0">
                <i class="fas fa-info-circle me-2"></i>Personal Information
            </h5>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Profile", "Student", FormMethod.Post, new { @class = "profile-form", id = "profileForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.Role)

                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label fw-bold">
                                <i class="fas fa-user me-2 text-mint"></i>Full Name *
                            </label>
                            @Html.TextBoxFor(m => m.Name, new
                            {
                                @class = "form-control form-control-lg",
                                @placeholder = "Enter your full name",
                                @maxlength = "50"
                            })
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label fw-bold">
                                <i class="fas fa-envelope me-2 text-mint"></i>Email Address *
                            </label>
                            @Html.TextBoxFor(m => m.Email, new
                            {
                                @class = "form-control form-control-lg",
                                @placeholder = "Enter your email address",
                                @maxlength = "100",
                                @type = "email"
                            })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label fw-bold">
                                <i class="fas fa-id-badge me-2 text-mint"></i>Student ID
                            </label>
                            <input type="text" class="form-control form-control-lg" value="STD-@Model.Id.ToString("D4")" readonly />
                            <small class="text-muted">This is unique student identifier</small>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="form-group">
                            <label class="form-label fw-bold">
                                <i class="fas fa-user-tag me-2 text-mint"></i>Account Type
                            </label>
                            <input type="text" class="form-control form-control-lg" value="@Model.Role" readonly />
                            <small class="text-muted">Your account role in the system</small>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h6 class="mb-0">
                        <i class="fas fa-save me-2 text-mint"></i>Save Basic Information
                    </h6>
                    <button type="submit" class="btn btn-mint btn-lg">
                        <i class="fas fa-save me-2"></i>Update Profile
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- Password Change Card -->
    <div class="card">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">
                <i class="fas fa-key me-2"></i>Change Password
            </h5>
        </div>
        <div class="card-body">

            @using (Html.BeginForm("Profile", "Student", FormMethod.Post, new { @class = "password-form", id = "passwordForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Id)
                @Html.HiddenFor(m => m.Name)
                @Html.HiddenFor(m => m.Email)
                @Html.HiddenFor(m => m.Role)

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <div class="form-group">
                            <label class="form-label fw-bold">
                                <i class="fas fa-lock me-2 text-warning"></i>Current Password
                            </label>
                            <div class="input-group">
                                <input type="password" name="currentPassword" class="form-control form-control-lg"
                                       placeholder="Enter current password" maxlength="100" />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword(this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="form-group">
                            <label class="form-label fw-bold">
                                <i class="fas fa-key me-2 text-warning"></i>New Password
                            </label>
                            <div class="input-group">
                                <input type="password" name="newPassword" class="form-control form-control-lg"
                                       placeholder="Enter new password" maxlength="100" />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword(this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                            <small class="text-muted">Must be at least 6 characters long</small>
                        </div>
                    </div>

                    <div class="col-md-4 mb-3">
                        <div class="form-group">
                            <label class="form-label fw-bold">
                                <i class="fas fa-check-double me-2 text-warning"></i>Confirm Password
                            </label>
                            <div class="input-group">
                                <input type="password" name="confirmPassword" class="form-control form-control-lg"
                                       placeholder="Confirm new password" maxlength="100" />
                                <button class="btn btn-outline-secondary" type="button" onclick="togglePassword(this)">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <div class="password-strength">
                        <small class="text-muted">Password Requirements:</small>
                        <ul class="small text-muted mb-0">
                            <li>At least 6 characters long</li>
                            <li>Different from current password</li>
                        </ul>
                    </div>
                    <button type="submit" class="btn btn-warning btn-lg">
                        <i class="fas fa-key me-2"></i>Change Password
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Validation Summary -->
@if (!ViewData.ModelState.IsValid)
{
    <div class="validation-summary alert alert-danger mt-3">
        <h6><i class="fas fa-exclamation-triangle me-2"></i>Please correct the following errors:</h6>
        @Html.ValidationSummary(false, "", new { @class = "mb-0" })
    </div>
}

<style>
    .bg-mint {
        background-color: var(--mint-medium) !important;
    }

    .text-mint {
        color: var(--mint-dark) !important;
    }

    .btn-mint {
        background-color: var(--mint-medium);
        border-color: var(--mint-medium);
        color: white;
    }

    .btn-mint:hover {
        background-color: var(--mint-dark);
        border-color: var(--mint-dark);
        color: white;
    }

    .profile-form .form-control:focus,
    .password-form .form-control:focus {
        border-color: var(--mint-medium);
        box-shadow: 0 0 0 0.2rem rgba(72, 201, 176, 0.25);
    }

    .stats-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: none;
        border-radius: 15px;
        overflow: hidden;
    }

    .stats-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
    }

    .stats-card-blue {
        background: linear-gradient(45deg, #007bff, #6610f2);
        color: white;
    }

    .stats-card-green {
        background: linear-gradient(45deg, #28a745, #20c997);
        color: white;
    }

    .stats-card-orange {
        background: linear-gradient(45deg, #ffc107, #fd7e14);
        color: white;
    }

    .form-control-lg {
        border-radius: 10px;
    }

    .card {
        border-radius: 15px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        border: none;
    }

    .card-header {
        border-radius: 15px 15px 0 0 !important;
    }

    .input-group .btn {
        border-radius: 0 10px 10px 0;
    }

    .validation-summary {
        border-radius: 10px;
    }

    media (max-width: 768px) {
        .d-flex.justify-content-between {
            flex-direction: column;
            gap: 15px;
        }

        .btn-lg {
            width: 100%;
        }
    }
</style>

<script>
    function togglePassword(button) {
        const input = button.previousElementSibling;
        const icon = button.querySelector('i');

        if (input.type === 'password') {
            input.type = 'text';
            icon.classList.remove('fa-eye');
            icon.classList.add('fa-eye-slash');
        } else {
            input.type = 'password';
            icon.classList.remove('fa-eye-slash');
            icon.classList.add('fa-eye');
        }
    }

    // Form validation
    document.getElementById('passwordForm').addEventListener('submit', function (e) {
        const newPassword = document.querySelector('input[name="newPassword"]').value;
        const confirmPassword = document.querySelector('input[name="confirmPassword"]').value;
        const currentPassword = document.querySelector('input[name="currentPassword"]').value;

        // Only validate if user is trying to change password
        if (newPassword || confirmPassword || currentPassword) {
            if (!currentPassword) {
                alert('Please enter your current password to change it.');
                e.preventDefault();
                return;
            }

            if (newPassword.length < 6) {
                alert('New password must be at least 6 characters long.');
                e.preventDefault();
                return;
            }

            if (newPassword !== confirmPassword) {
                alert('New password and confirm password do not match.');
                e.preventDefault();
                return;
            }
        }
    });

    // Auto-dismiss alerts after 5 seconds
    setTimeout(function () {
        const alerts = document.querySelectorAll('.alert-dismissible');
        alerts.forEach(function (alert) {
            const bsAlert = new bootstrap.Alert(alert);
            bsAlert.close();
        });
    }, 5000);
</script>