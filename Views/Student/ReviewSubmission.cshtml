@model Brain_Mint.Models.AssignmentSubmission
@{
    ViewBag.Title = "Review Submission";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="dashboard-card">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="card-title mb-2">Review Submission</h2>
            <p class="mb-1">
                <i class="fas fa-book me-2"></i><strong>Assignment:</strong> @Model.Assignment.Title
            </p>
            <p class="mb-1">
                <i class="fas fa-user me-2"></i><strong>Student:</strong> @Model.Student.Name
            </p>
            <p class="mb-1">
                <i class="fas fa-envelope me-2"></i><strong>Email:</strong> @Model.Student.Email
            </p>
            <p class="mb-1">
                <i class="fas fa-calendar me-2"></i><strong>Submitted:</strong> @Model.SubmissionDate.ToString("MMM dd, yyyy 'at' hh:mm tt")
            </p>
        </div>
        <div class="text-end">
            <span class="badge @(Model.Status == "Graded" ? "bg-success" :
                                Model.Status == "Late" ? "bg-warning text-dark" :
                                "bg-primary") fs-6 mb-2">
                @Model.Status
            </span>
            @if (Model.SubmissionDate > Model.Assignment.DueDate)
            {
                <br><span class="badge bg-danger fs-6">Late Submission</span>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Assignment Details -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-info-circle me-2"></i>Assignment Details
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Subject:</strong> @Model.Assignment.Subject</p>
                    <p><strong>Due Date:</strong> @Model.Assignment.DueDate.ToString("MMM dd, yyyy 'at' hh:mm tt")</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Max Points:</strong> @Model.Assignment.MaxPoints</p>
                    <p><strong>Submission Type:</strong> @Model.Assignment.SubmissionType</p>
                </div>
            </div>
            <div class="mt-3">
                <strong>Instructions:</strong>
                <div class="p-3 bg-light border rounded mt-2">
                    @Html.Raw(Model.Assignment.Description.Replace("\n", "<br/>"))
                </div>
            </div>
        </div>
    </div>

    <!-- Student Submission -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-file-alt me-2"></i>Student Submission
            </h5>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.TextSubmission))
            {
                <div class="mb-4">
                    <h6>Text Submission:</h6>
                    <div class="p-3 border rounded bg-white submission-content">
                        @Html.Raw(Model.TextSubmission.Replace("\n", "<br/>"))
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <div class="mb-4">
                    <h6>Image Submission:</h6>
                    <div class="image-submission-container">
                        <p class="mb-2">
                            <strong>File:</strong> @Model.OriginalFileName
                            <a href="@Url.Action("DownloadSubmissionImage", "Teacher", new { submissionId = Model.Id })"
                               class="btn btn-sm btn-outline-primary ms-2" target="_blank">
                                <i class="fas fa-download"></i> Download
                            </a>
                        </p>
                        <div class="border rounded p-3 bg-light">
                            <img src="@Url.Content(Model.ImagePath)"
                                 class="img-fluid submission-image"
                                 alt="Student submission"
                                 style="max-width: 100%; max-height: 500px; cursor: pointer;"
                                 onclick="showImageModal(this.src)" />
                        </div>
                    </div>
                </div>
            }

            @if (string.IsNullOrEmpty(Model.TextSubmission) && string.IsNullOrEmpty(Model.ImagePath))
            {
                <div class="text-center py-4">
                    <i class="fas fa-exclamation-triangle fa-2x text-warning mb-3"></i>
                    <h6 class="text-muted">No submission content found</h6>
                </div>
            }
        </div>
    </div>

    <!-- Grading Section -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-star me-2"></i>Grading
            </h5>
        </div>
        <div class="card-body">
            @if (Model.Points.HasValue)
            {
                <!-- Show existing grade -->
                <div class="alert alert-info">
                    <h6><i class="fas fa-check-circle me-2"></i>Already Graded</h6>
                    <p class="mb-2">
                        <strong>Grade:</strong> @Model.Points / @Model.Assignment.MaxPoints
                        (@((Model.Points.Value / (double)Model.Assignment.MaxPoints * 100).ToString("F1"))%)
                    </p>
                    @if (Model.GradedDate.HasValue)
                    {
                        <p class="mb-2"><strong>Graded on:</strong> @Model.GradedDate.Value.ToString("MMM dd, yyyy 'at' hh:mm tt")</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.TeacherFeedback))
                    {
                        <p class="mb-2"><strong>Current Feedback:</strong></p>
                        <div class="p-3 bg-white border rounded">
                            @Model.TeacherFeedback
                        </div>
                    }
                    <button class="btn btn-outline-primary mt-3" onclick="showUpdateGradeForm()">
                        <i class="fas fa-edit me-1"></i>Update Grade
                    </button>
                </div>
            }

            <!-- Grading Form -->
            <div id="gradingForm" style="@(Model.Points.HasValue ? "display: none;" : "")">
                @using (Html.BeginForm("GradeSubmission", "Teacher", FormMethod.Post))
                {
                    @Html.Hidden("id", Model.Id)

                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group mb-3">
                                <label class="form-label">
                                    <i class="fas fa-trophy me-1"></i>Points (out of @Model.Assignment.MaxPoints)
                                </label>
                                <input type="number" class="form-control" name="points"
                                       min="0" max="@Model.Assignment.MaxPoints"
                                       value="@Model.Points" required
                                       oninput="calculatePercentage(this.value, @Model.Assignment.MaxPoints)" />
                                <small class="text-muted">
                                    Percentage: <span id="percentageDisplay">@(Model.Points.HasValue ? (Model.Points.Value / (double)Model.Assignment.MaxPoints * 100).ToString("F1") : "0.0")%</span>
                                </small>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="form-group mb-3">
                                <label class="form-label">
                                    <i class="fas fa-comment me-1"></i>Feedback for Student
                                </label>
                                <textarea class="form-control" name="feedback" rows="4"
                                          placeholder="Provide constructive feedback to help the student learn...">@Model.TeacherFeedback</textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Quick Grade Buttons -->
                    <div class="mb-3">
                        <label class="form-label">Quick Grade:</label>
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-outline-success"
                                    onclick="setQuickGrade(@Model.Assignment.MaxPoints, 'Excellent work!')">
                                Perfect (@Model.Assignment.MaxPoints/@Model.Assignment.MaxPoints)
                            </button>
                            <button type="button" class="btn btn-outline-primary"
                                    onclick="setQuickGrade(@(Math.Ceiling(Model.Assignment.MaxPoints * 0.9)), 'Good work!')">
                                A (@(Math.Ceiling(Model.Assignment.MaxPoints * 0.9))/@Model.Assignment.MaxPoints)
                            </button>
                            <button type="button" class="btn btn-outline-info"
                                    onclick="setQuickGrade(@(Math.Ceiling(Model.Assignment.MaxPoints * 0.8)), 'Satisfactory work.')">
                                B (@(Math.Ceiling(Model.Assignment.MaxPoints * 0.8))/@Model.Assignment.MaxPoints)
                            </button>
                            <button type="button" class="btn btn-outline-warning"
                                    onclick="setQuickGrade(@(Math.Ceiling(Model.Assignment.MaxPoints * 0.7)), 'Needs improvement.')">
                                C (@(Math.Ceiling(Model.Assignment.MaxPoints * 0.7))/@Model.Assignment.MaxPoints)
                            </button>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="@Url.Action("AssignmentDetails", "Teacher", new { id = Model.AssignmentId })"
                           class="btn btn-secondary">
                            <i class="fas fa-arrow-left me-1"></i>Back to Assignment
                        </a>

                        <div>
                            @if (Model.Points.HasValue)
                            {
                                <button type="button" class="btn btn-outline-secondary me-2" onclick="cancelUpdate()">
                                    Cancel
                                </button>
                            }
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save me-1"></i>
                                @(Model.Points.HasValue ? "Update Grade" : "Save Grade")
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Image Modal -->
<div class="modal fade" id="imageModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Student Submission Image</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="" class="img-fluid" style="max-width: 100%; height: auto;" />
            </div>
            <div class="modal-footer">
                <a id="downloadImageLink" href="" class="btn btn-primary" target="_blank">
                    <i class="fas fa-download me-1"></i>Download Full Size
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function calculatePercentage(points, maxPoints) {
            const percentage = (points / maxPoints * 100).toFixed(1);
            document.getElementById('percentageDisplay').textContent = percentage + '%';
        }

        function setQuickGrade(points, feedback) {
            document.querySelector('input[name="points"]').value = points;
            document.querySelector('textarea[name="feedback"]').value = feedback;
            calculatePercentage(points, @Model.Assignment.MaxPoints);
        }

        function showUpdateGradeForm() {
            document.getElementById('gradingForm').style.display = 'block';
            document.querySelector('.alert-info').style.display = 'none';
        }

        function cancelUpdate() {
            document.getElementById('gradingForm').style.display = 'none';
            document.querySelector('.alert-info').style.display = 'block';
        }

        function showImageModal(imageSrc) {
            document.getElementById('modalImage').src = imageSrc;
            document.getElementById('downloadImageLink').href = '@Url.Action("DownloadSubmissionImage", "Teacher", new { submissionId = Model.Id })';
            new bootstrap.Modal(document.getElementById('imageModal')).show();
        }

        // Auto-save draft functionality
        let autoSaveTimer;
        document.querySelector('textarea[name="feedback"]').addEventListener('input', function() {
            clearTimeout(autoSaveTimer);
            autoSaveTimer = setTimeout(function() {
                // Could implement auto-save draft here
                console.log('Auto-saving feedback draft...');
            }, 3000);
        });
    </script>
}

<style>
    .submission-content {
        min-height: 100px;
        line-height: 1.6;
        font-size: 1.05rem;
        word-wrap: break-word;
    }

    .submission-image {
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        transition: transform 0.2s;
    }

    .submission-image:hover {
        transform: scale(1.02);
    }

    .image-submission-container {
        max-width: 100%;
    }

    .card-header {
        background-color: rgba(72, 201, 176, 0.1);
        border-bottom: 2px solid var(--mint-light);
    }

    .badge.fs-6 {
        font-size: 0.9rem !important;
    }

    .btn-group .btn {
        font-size: 0.875rem;
        padding: 0.375rem 0.75rem;
    }

    media (max-width: 768px) {
        .btn-group {
            flex-direction: column;
        }

        .btn-group .btn {
            margin-bottom: 0.25rem;
        }
    }
</style>