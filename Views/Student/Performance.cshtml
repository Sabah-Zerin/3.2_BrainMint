@model Brain_Mint.Models.StudentPerformance
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<h2>Performance Overview</h2>

<div class="row">
    <div class="col-md-6">
        <h4>Quiz Scores</h4>
        @if (Model.QuizScores.Any())
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Quiz</th>
                        <th>Score</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var quiz in Model.QuizScores)
                    {
                        <tr>
                            <td>@quiz.Name</td>
                            <td>
                                <div class="progress">
                                    <div class="progress-bar" role="progressbar"
                                         style="width: @quiz.Score%;"
                                         aria-valuenow="@quiz.Score"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        @quiz.Score%
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No quiz scores available</div>
        }
    </div>

    <div class="col-md-6">
        <h4>Assignment Scores</h4>
        @if (Model.AssignmentScores.Any())
        {
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Assignment</th>
                        <th>Score</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var assignment in Model.AssignmentScores)
                    {
                        <tr>
                            <td>@assignment.Name</td>
                            <td>
                                <div class="progress">
                                    <div class="progress-bar" role="progressbar"
                                         style="width: @assignment.Score%;"
                                         aria-valuenow="@assignment.Score"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        @assignment.Score%
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="alert alert-info">No assignment scores available</div>
        }
    </div>
</div>