@model Brain_Mint.Models.SubmitAssignmentViewModel
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewBag.Title = "Assignment - " + Model.Assignment.Title;
}

<div class="dashboard-card">
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="card-title mb-2">@Model.Assignment.Title</h2>
            <p class="text-muted mb-1">
                <i class="fas fa-user me-2"></i>Created by: @Model.Assignment.CreatedBy.Name
            </p>
            <p class="text-muted mb-1">
                <i class="fas fa-calendar me-2"></i>Due: @Model.Assignment.DueDate.ToString("MMM dd, yyyy 'at' hh:mm tt")
            </p>
            <p class="text-muted">
                <i class="fas fa-star me-2"></i>Max Points: @Model.Assignment.MaxPoints
            </p>
        </div>
        <div class="text-end">
            @if (DateTime.Now > Model.Assignment.DueDate)
            {
                <span class="badge bg-danger fs-6">Overdue</span>
            }
            else
            {
                var timeLeft = Model.Assignment.DueDate - DateTime.Now;
                if (timeLeft.TotalDays < 1)
                {
                    <span class="badge bg-warning text-dark fs-6">Due Soon</span>
                }
                else
                {
                    <span class="badge bg-success fs-6">Open</span>
                }
            }
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Assignment Instructions -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="fas fa-info-circle me-2"></i>Assignment Instructions
            </h5>
            <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#instructionsModal">
                <i class="fas fa-expand me-1"></i>View Full Instructions
            </button>
        </div>
        <div class="card-body">
            <div class="assignment-description">
                @Html.Raw(Model.Assignment.Description.Replace("\n", "<br/>"))
            </div>
        </div>
    </div>

    <!-- Submission Status -->
    @if (Model.HasExistingSubmission)
    {
        <div class="alert alert-info">
            <h5><i class="fas fa-check-circle me-2"></i>Submission Status</h5>
            <p class="mb-2">
                <strong>Submitted:</strong> @Model.ExistingSubmission.SubmissionDate.ToString("MMM dd, yyyy 'at' hh:mm tt")
            </p>
            <p class="mb-2">
                <strong>Status:</strong>
                <span class="badge @(Model.ExistingSubmission.Status == "Graded" ? "bg-success" : Model.ExistingSubmission.Status == "Late" ? "bg-warning text-dark" : "bg-primary")">
                    @Model.ExistingSubmission.Status
                </span>
            </p>
            @if (Model.ExistingSubmission.Points.HasValue)
            {
                <p class="mb-2">
                    <strong>Grade:</strong> @Model.ExistingSubmission.Points / @Model.Assignment.MaxPoints
                </p>
            }
            @if (!string.IsNullOrEmpty(Model.ExistingSubmission.TeacherFeedback))
            {
                <div class="mt-3">
                    <strong>Teacher Feedback:</strong>
                    <div class="p-3 bg-light border rounded mt-2">
                        @Model.ExistingSubmission.TeacherFeedback
                    </div>
                </div>
            }
        </div>
    }

    <!-- Submission Form -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">
                <i class="fas fa-upload me-2"></i>
                @(Model.HasExistingSubmission ? "Update Submission" : "Submit Assignment")
            </h5>
        </div>
        <div class="card-body">
            @using (Html.BeginForm("SubmitAssignment", "Student", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                @Html.HiddenFor(m => m.AssignmentId)

                <div class="form-group mb-4">
                    <label class="form-label">
                        <i class="fas fa-edit me-2"></i>Text Submission
                    </label>
                    @Html.TextAreaFor(m => m.TextSubmission, new
                    {
                        @class = "form-control",
                        rows = 8,
                        placeholder = "Enter your assignment submission here..."
                    })
                    <div class="form-text">Provide your written response, answers, or explanation here.</div>
                </div>

                if (Model.Assignment.SubmissionType == "Both" || Model.Assignment.SubmissionType == "Image")
                {
                    <div class="form-group mb-4">
                        <label class="form-label">
                            <i class="fas fa-image me-2"></i>Image Upload (Optional)
                        </label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" />
                        <div class="form-text">
                            Upload diagrams, handwritten work, or other images. Max size: 5MB.
                            Supported formats: JPG, PNG, GIF, BMP
                        </div>
                        @if (Model.ExistingSubmission != null && !string.IsNullOrEmpty(Model.ExistingSubmission.ImagePath))
                        {
                            <div class="mt-2">
                                <strong>Current Image:</strong> @Model.ExistingSubmission.OriginalFileName
                                <a href="@Url.Action("DownloadSubmissionImage", "Teacher", new { submissionId = Model.ExistingSubmission.Id })"
                                   class="btn btn-sm btn-outline-primary ms-2" target="_blank">
                                    <i class="fas fa-download"></i> View
                                </a>
                            </div>
                        }
                    </div>
                }

                <div class="d-flex justify-content-between align-items-center">
                    <a href="@Url.Action("AssignmentParticipation", "Student")" class="btn btn-secondary">
                        <i class="fas fa-arrow-left me-1"></i>Back to Assignments
                    </a>

                    <div>
                        @if (DateTime.Now <= Model.Assignment.DueDate || Model.HasExistingSubmission)
                        {
                            <button type="submit" class="btn btn-primary btn-lg" onclick="return confirmSubmission()">
                                <i class="fas fa-paper-plane me-2"></i>
                                @(Model.HasExistingSubmission ? "Update Submission" : "Submit Assignment")
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-danger" disabled>
                                <i class="fas fa-clock me-2"></i>Assignment Overdue
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Instructions Modal -->
<div class="modal fade" id="instructionsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-info-circle me-2"></i>@Model.Assignment.Title - Instructions
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="assignment-details mb-4">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Subject:</strong> @Model.Assignment.Subject</p>
                            <p><strong>Due Date:</strong> @Model.Assignment.DueDate.ToString("MMM dd, yyyy 'at' hh:mm tt")</p>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Max Points:</strong> @Model.Assignment.MaxPoints</p>
                            <p><strong>Submission Type:</strong> @Model.Assignment.SubmissionType</p>
                        </div>
                    </div>
                </div>

                <h6>Full Instructions:</h6>
                <div class="p-3 bg-light border rounded">
                    @Html.Raw(Model.Assignment.Description.Replace("\n", "<br/>"))
                </div>

                <div class="mt-4">
                    <h6>Submission Guidelines:</h6>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-check text-success me-2"></i>Review all instructions carefully before submitting</li>
                        <li><i class="fas fa-check text-success me-2"></i>Ensure your work is original and follows academic integrity policies</li>
                        <li><i class="fas fa-check text-success me-2"></i>Submit before the due date to avoid late penalties</li>
                        <li><i class="fas fa-check text-success me-2"></i>You can update your submission until the due date</li>
                        @if (Model.Assignment.SubmissionType == "Both" || Model.Assignment.SubmissionType == "Image")
                        {
                            <li><i class="fas fa-check text-success me-2"></i>Image files should be clear and readable (max 5MB)</li>
                        }
                    </ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        function confirmSubmission() {
            var textContent = document.querySelector('textarea[name="TextSubmission"]').value.trim();
            var fileInput = document.querySelector('input[name="imageFile"]');
            var hasFile = fileInput && fileInput.files.length > 0;

            if (!textContent && !hasFile) {
                alert('Please provide either text submission or upload an image before submitting.');
                return false;
            }

            var message = @Model.HasExistingSubmission.ToString().ToLower()
                ? 'Are you sure you want to update your submission?'
                : 'Are you sure you want to submit this assignment?';

            return confirm(message);
        }

        // Auto-save functionality (optional)
        var autoSaveTimer;
        document.querySelector('textarea[name="TextSubmission"]').addEventListener('input', function() {
            clearTimeout(autoSaveTimer);
            autoSaveTimer = setTimeout(function() {
                // Auto-save logic can be implemented here
                console.log('Auto-save triggered');
            }, 5000);
        });
    </script>
}

<style>
    .assignment-description {
        line-height: 1.6;
        font-size: 1.1rem;
    }

    .badge.fs-6 {
        font-size: 0.9rem !important;
    }

    .card-header {
        background-color: rgba(72, 201, 176, 0.1);
        border-bottom: 2px solid var(--mint-light);
    }

    .form-control:focus {
        border-color: var(--mint-medium);
        box-shadow: 0 0 0 0.25rem rgba(72, 201, 176, 0.25);
    }

    .btn-primary {
        background-color: var(--mint-medium);
        border-color: var(--mint-medium);
    }

        .btn-primary:hover {
            background-color: var(--mint-dark);
            border-color: var(--mint-dark);
        }
</style>