@model List<Brain_Mint.Models.Quiz>
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<h2>Quiz Participation</h2>
<table class="table table-striped">
    <thead class="thead-dark">
        <tr>
            <th>Quiz Title</th>
            <th>Category</th>
            <th>Difficulty</th>
            <th>Time Limit</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var quiz in Model)
        {
            <tr>
                <td>@quiz.Title</td>
                <td>@quiz.Category</td>
                <td>@quiz.Difficulty</td>
                <td>@quiz.TimeLimit minutes</td>
                <td>
                    <span class="badge bg-success">@quiz.Status</span>
                </td>
                <td>
                    <a href="#" class="btn btn-sm btn-primary">Take Quiz</a>
                </td>
            </tr>
        }
    </tbody>
</table>