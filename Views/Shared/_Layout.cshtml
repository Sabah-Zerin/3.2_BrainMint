@{
    bool isLoggedIn = Session["UserName"] != null;
    bool isAuthPage = ViewContext.RouteData.Values["Controller"].ToString() == "Account";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Brainmint</title>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&family=Montserrat:wght@500;600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Site CSS -->
    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --mint-light: #a2d9ce;
            --mint-medium: #48c9b0;
            --mint-dark: #16a085;
            --sky-light: #85c1e9;
            --sky-dark: #3498db;
            --text-dark: #2c3e50;
            --text-light: #f8f9fa;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f4f6f9;
            color: var(--text-dark);
        }

        /* Navbar */
        .navbar {
            background: linear-gradient(90deg, var(--mint-medium), var(--sky-dark));
        }

        .navbar-brand {
            font-family: 'Montserrat', sans-serif;
            font-size: 1.5rem;
            font-weight: 600;
            color: white !important;
        }

        .nav-link {
            color: white !important;
            font-weight: 500;
            margin-left: 10px;
        }

            .nav-link:hover {
                text-decoration: underline;
            }

        /* Auth Pages */
        .auth-page {
            background: linear-gradient(135deg, var(--mint-light), var(--sky-light));
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .auth-card {
            max-width: 450px;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
        }

            .auth-card:hover {
                transform: translateY(-5px);
            }

        .auth-header {
            background: linear-gradient(to right, var(--mint-medium), var(--sky-dark));
            color: white;
            padding: 1.5rem;
            text-align: center;
        }

        .auth-title {
            font-family: 'Montserrat', sans-serif;
            font-weight: 600;
            font-size: 1.8rem;
            margin: 0;
        }

        .auth-body {
            padding: 2rem;
            background: #fff;
        }

        /* Sidebar */
        .main-content {
            margin-left: 250px;
            padding: 20px;
            transition: all 0.3s;
        }

        .sidebar-collapsed .main-content {
            margin-left: 80px;
        }

        .toggle-sidebar {
            position: fixed;
            left: 10px;
            top: 70px;
            z-index: 1000;
            cursor: pointer;
            background: var(--mint-medium);
            border: none;
            color: white;
            border-radius: 6px;
            padding: 8px 12px;
        }

            .toggle-sidebar:hover {
                background: var(--sky-dark);
            }

        footer {
            background: #fff;
            padding: 15px;
            border-top: 1px solid #dee2e6;
            text-align: center;
            font-size: 0.9rem;
            color: #6c757d;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body class="@(isAuthPage ? "auth-page" : "") @(isLoggedIn && !isAuthPage ? "has-sidebar" : "")">

    <!-- Top Navbar (only when not on auth page) -->
    @if (!isAuthPage)
    {
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">Brainmint</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">@Html.ActionLink("Home", "Index", "Home", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("About", "About", "Home", null, new { @class = "nav-link" })</li>
                        <li class="nav-item">@Html.ActionLink("Contact", "Contact", "Home", null, new { @class = "nav-link" })</li>
                    </ul>
                    <ul class="navbar-nav">
                        @if (!isLoggedIn)
                        {
                            <li class="nav-item">@Html.ActionLink("Login", "Login", "Account", null, new { @class = "nav-link" })</li>
                            <li class="nav-item">@Html.ActionLink("Sign Up", "Signup", "Account", null, new { @class = "nav-link" })</li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <span class="navbar-text text-white me-3">Hello, @Session["UserName"]</span>
                            </li>
                            <li class="nav-item">@Html.ActionLink("Logout", "Logout", "Account", null, new { @class = "nav-link" })</li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    }

    <!-- Sidebar (if logged in) -->
    @if (isLoggedIn && !isAuthPage)
    {
        @Html.Partial("_Sidebar")
        <button class="toggle-sidebar"><i class="fas fa-bars"></i></button>
    }

    <!-- Page Body -->
    <div class="@(isLoggedIn && !isAuthPage ? "main-content" : "container body-content mt-4")">
        @RenderBody()

        @if (!isAuthPage)
        {
            <footer>
                <p>&copy; @DateTime.Now.Year - Brainmint</p>
            </footer>
        }
    </div>

    <!-- Scripts -->
    @Scripts.Render("~/bundles/jquery")
    @RenderSection("scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(function () {
            $('.toggle-sidebar').click(function () {
                $('body').toggleClass('sidebar-collapsed');
            });
        });
    </script>
</body>
</html>
