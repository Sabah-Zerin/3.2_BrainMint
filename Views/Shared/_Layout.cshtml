@model Brain_Mint.Models.AssignmentSubmission
@{
    ViewBag.Title = "View Submission Result";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="submission-result-container">
    <div class="header-section d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="page-title">
                <i class="fas fa-file-alt me-2 text-primary"></i>Submission Result
            </h2>
            <p><i class="fas fa-book me-2 text-secondary"></i><strong>Assignment:</strong> @Model.Assignment.Title</p>
            <p><i class="fas fa-user-tie me-2 text-secondary"></i><strong>Teacher:</strong> @Model.Assignment.CreatedBy.Name</p>
            <p><i class="fas fa-calendar me-2 text-secondary"></i><strong>Submitted:</strong> @Model.SubmissionDate.ToString("MMM dd, yyyy 'at' hh:mm tt")</p>
        </div>
        <div class="text-end">
            <span class="status-badge @(Model.Status == "Graded" ? "bg-success" :
                                        Model.Status == "Late" ? "bg-warning" :
                                        Model.Status == "Submitted" ? "bg-info" : "bg-secondary")">
                @Model.Status
            </span>
            @if (Model.SubmissionDate > Model.Assignment.DueDate)
            {
                <br><span class="badge bg-danger mt-2">Late Submission</span>
            }
        </div>
    </div>

    <!-- Assignment Information -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-gradient-primary text-white">
            <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Assignment Details</h5>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <p><strong>Subject:</strong> @Model.Assignment.Subject</p>
                    <p><strong>Due Date:</strong> @Model.Assignment.DueDate.ToString("MMM dd, yyyy 'at' hh:mm tt")</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Max Points:</strong> @Model.Assignment.MaxPoints</p>
                    <p><strong>Submission Type:</strong> @Model.Assignment.SubmissionType</p>
                </div>
            </div>
            <div>
                <strong>Instructions:</strong>
                <div class="p-3 bg-light rounded border mt-2 assignment-description">
                    @Model.Assignment.Description
                </div>
            </div>
        </div>
    </div>

    <!-- Grade Information -->
    @if (Model.Status == "Graded" && Model.Points.HasValue)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header @(Model.Points.Value >= Model.Assignment.MaxPoints * 0.8 ? "bg-success" :
                                    Model.Points.Value >= Model.Assignment.MaxPoints * 0.7 ? "bg-info" :
                                    Model.Points.Value >= Model.Assignment.MaxPoints * 0.6 ? "bg-warning" : "bg-danger") text-white">
                <h5 class="mb-0"><i class="fas fa-star me-2"></i>Your Grade</h5>
            </div>
            <div class="card-body">
                <div class="row text-center mb-3">
                    <div class="col-md-4">
                        <h3 class="highlight">@Model.Points / @Model.Assignment.MaxPoints</h3>
                        <p class="text-muted">Points Earned</p>
                    </div>
                    <div class="col-md-4">
                        <h3 class="highlight">@((Model.Points.Value / (double)Model.Assignment.MaxPoints * 100).ToString("F1"))%</h3>
                        <p class="text-muted">Percentage</p>
                    </div>
                    <div class="col-md-4">
                        <h3 class="performance @(Model.Points.Value >= Model.Assignment.MaxPoints * 0.8 ? "text-success" :
                                                Model.Points.Value >= Model.Assignment.MaxPoints * 0.7 ? "text-info" :
                                                Model.Points.Value >= Model.Assignment.MaxPoints * 0.6 ? "text-warning" : "text-danger")">
                            @(Model.Points.Value >= Model.Assignment.MaxPoints * 0.8 ? "Excellent" :
                              Model.Points.Value >= Model.Assignment.MaxPoints * 0.7 ? "Good" :
                              Model.Points.Value >= Model.Assignment.MaxPoints * 0.6 ? "Fair" : "Needs Improvement")
                        </h3>
                        <p class="text-muted">Performance</p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.TeacherFeedback))
                {
                    <div class="teacher-feedback p-3 bg-light rounded mb-3">
                        <h6><i class="fas fa-comment-alt me-2"></i>Teacher Feedback</h6>
                        <p class="mb-0">@Model.TeacherFeedback</p>
                    </div>
                }

                @if (Model.GradedDate.HasValue)
                {
                    <small class="text-muted">
                        <i class="fas fa-clock me-1"></i>Graded on @Model.GradedDate.Value.ToString("MMM dd, yyyy 'at' hh:mm tt")
                    </small>
                }
            </div>
        </div>
    }
    else if (Model.Status != "Graded")
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="fas fa-hourglass-half me-2"></i>Grading Status</h5>
            </div>
            <div class="card-body text-center">
                <i class="fas fa-spinner fa-2x text-info mb-3"></i>
                <h5>Your submission is being reviewed</h5>
                <p class="text-muted">Your teacher will grade this assignment soon. Check back later for results.</p>
            </div>
        </div>
    }

    <!-- Your Submission -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-gradient-dark text-white">
            <h5 class="mb-0"><i class="fas fa-file-upload me-2"></i>Your Submission</h5>
        </div>
        <div class="card-body">
            @if (!string.IsNullOrEmpty(Model.TextSubmission))
            {
                <div class="mb-4">
                    <h6><i class="fas fa-align-left me-2"></i>Text Submission</h6>
                    <div class="p-3 border rounded bg-light submission-text">@Model.TextSubmission</div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                <div class="mb-4">
                    <h6><i class="fas fa-image me-2"></i>Image Submission</h6>
                    <div class="text-center">
                        <img src="@Url.Content("~/" + Model.ImagePath)" alt="Submission Image"
                             class="img-fluid border rounded shadow-sm mb-2" style="max-height: 450px;" />
                        <br>
                        <small class="text-muted"><i class="fas fa-file me-1"></i>@Model.OriginalFileName</small>
                    </div>
                </div>
            }

            @if (string.IsNullOrEmpty(Model.TextSubmission) && string.IsNullOrEmpty(Model.ImagePath))
            {
                <div class="text-center text-muted">
                    <i class="fas fa-exclamation-triangle fa-2x mb-2"></i>
                    <p>No submission content found.</p>
                </div>
            }

            @if (Model.LastModified.HasValue && Model.LastModified != Model.SubmissionDate)
            {
                <hr>
                <small class="text-muted"><i class="fas fa-edit me-1"></i>Last modified: @Model.LastModified.Value.ToString("MMM dd, yyyy 'at' hh:mm tt")</small>
            }
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="d-flex justify-content-between flex-wrap gap-2">
        <a href="@Url.Action("AssignmentParticipation", "Student")" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Back to Assignments
        </a>
        @if (DateTime.Now <= Model.Assignment.DueDate && Model.Status != "Graded")
        {
            <a href="@Url.Action("ViewAssignment", "Student", new { id = Model.AssignmentId })" class="btn btn-warning">
                <i class="fas fa-edit me-2"></i>Update Submission
            </a>
        }
    </div>
</div>

<style>
    .submission-result-container {
        background: #f9fafb;
        padding: 20px;
        border-radius: 12px;
    }

    .page-title {
        font-weight: 600;
        color: #2c3e50;
    }

    .status-badge {
        padding: 0.6em 1em;
        font-size: 0.95rem;
        border-radius: 20px;
    }

    .highlight {
        font-size: 1.8rem;
        font-weight: 700;
        color: #2c3e50;
    }

    .performance {
        font-weight: 600;
    }

    .teacher-feedback {
        border-left: 4px solid #0d6efd;
    }

    .assignment-description, .submission-text {
        white-space: pre-line;
        line-height: 1.6;
    }

    .img-fluid {
        transition: transform 0.25s ease;
    }

    .img-fluid:hover {
        transform: scale(1.03);
    }

    .bg-gradient-primary {
        background: linear-gradient(90deg, #0d6efd, #2c7be5);
    }

    .bg-gradient-dark {
        background: linear-gradient(90deg, #343a40, #495057);
    }

    @@media (max-width: 768px) {
        .d-flex.justify-content-between {
            flex-direction: column;
            gap: 10px;
        }
        .btn {
            width: 100%;
        }
    }
</style>
