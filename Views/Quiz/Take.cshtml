@model Brain_Mint.Models.TakeQuizViewModel
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewBag.Title = "Take Quiz - " + Model.Quiz.Title;
}

<div class="dashboard-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="card-title mb-0">@Model.Quiz.Title</h2>
        <div class="quiz-timer">
            <i class="fas fa-clock text-warning"></i>
            <span id="timeRemaining" class="fw-bold text-warning">@Model.Quiz.TimeLimit:00</span>
        </div>
    </div>

    <div class="quiz-info mb-4 p-3 bg-light rounded">
        <div class="row">
            <div class="col-md-3">
                <strong>Category:</strong> @Model.Quiz.Category
            </div>
            <div class="col-md-3">
                <strong>Difficulty:</strong> @Model.Quiz.Difficulty
            </div>
            <div class="col-md-3">
                <strong>Questions:</strong> @Model.Questions.Count
            </div>
            <div class="col-md-3">
                <strong>Time Limit:</strong> @Model.Quiz.TimeLimit minutes
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Quiz.Description))
        {
            <div class="mt-2">
                <strong>Description:</strong> @Model.Quiz.Description
            </div>
        }
    </div>

    <form id="quizForm" method="post" action="@Url.Action("SubmitQuiz", "Quiz")">
        <input type="hidden" name="attemptId" value="@Model.AttemptId" />

        @for (int i = 0; i < Model.Questions.Count; i++)
        {
            var question = Model.Questions[i];
            <div class="question-card mb-4 p-4 border rounded">
                <div class="question-header mb-3">
                    <h5 class="question-number">
                        Question @question.QuestionOrder
                        <span class="badge @(question.QuestionType == "MultipleChoice" ? "bg-primary" : "bg-info")">
                            @(question.QuestionType == "MultipleChoice" ? "Multiple Choice" : "Short Answer")
                        </span>
                    </h5>
                </div>

                <div class="question-text mb-3">
                    <p class="lead">@question.QuestionText</p>
                </div>

                @if (question.QuestionType == "MultipleChoice")
                {
                    <div class="options-container">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio"
                                   name="question_@question.Id" id="q@(question.Id)_A" value="A" required>
                            <label class="form-check-label" for="q@(question.Id)_A">
                                <strong>A)</strong> @question.OptionA
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio"
                                   name="question_@question.Id" id="q@(question.Id)_B" value="B" required>
                            <label class="form-check-label" for="q@(question.Id)_B">
                                <strong>B)</strong> @question.OptionB
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio"
                                   name="question_@question.Id" id="q@(question.Id)_C" value="C" required>
                            <label class="form-check-label" for="q@(question.Id)_C">
                                <strong>C)</strong> @question.OptionC
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio"
                                   name="question_@question.Id" id="q@(question.Id)_D" value="D" required>
                            <label class="form-check-label" for="q@(question.Id)_D">
                                <strong>D)</strong> @question.OptionD
                            </label>
                        </div>
                    </div>
                }
                else
                {
                    <div class="short-answer-container">
                        <textarea class="form-control"
                                  name="question_@question.Id"
                                  id="q@(question.Id)_text"
                                  rows="4"
                                  placeholder="Type your answer here..."
                                  required></textarea>
                    </div>
                }
            </div>
        }

        <div class="text-center mt-4">
            <button type="button" class="btn btn-warning me-3" onclick="showSubmitConfirmation()">
                <i class="fas fa-paper-plane"></i> Submit Quiz
            </button>
            <a href="@Url.Action("Index", "Quiz")" class="btn btn-secondary"
               onclick="return confirm('Are you sure you want to leave? Your progress will be lost.')">
                <i class="fas fa-times"></i> Cancel
            </a>
        </div>
    </form>
</div>

<!-- Submit Confirmation Modal -->
<div class="modal fade" id="submitConfirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Submit Quiz</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to submit your quiz?</p>
                <p class="text-warning"><strong>Warning:</strong> Once submitted, you cannot change your answers.</p>
                <div id="unansweredQuestions" class="alert alert-warning" style="display: none;">
                    <strong>Unanswered Questions:</strong>
                    <ul id="unansweredList"></ul>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="submitQuiz()">Submit Quiz</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Timer functionality
        let timeLimit = @Model.Quiz.TimeLimit * 60; // Convert to seconds
        let startTime = new Date("@Model.StartTime.ToString("yyyy-MM-ddTHH:mm:ss")");
        let currentTime = new Date();
        let elapsedSeconds = Math.floor((currentTime - startTime) / 1000);
        let remainingSeconds = Math.max(0, timeLimit - elapsedSeconds);

        function updateTimer() {
            let minutes = Math.floor(remainingSeconds / 60);
            let seconds = remainingSeconds % 60;

            document.getElementById('timeRemaining').textContent =
                minutes.toString().padStart(2, '0') + ':' + seconds.toString().padStart(2, '0');

            if (remainingSeconds <= 300) { // 5 minutes remaining
                document.getElementById('timeRemaining').className = 'fw-bold text-danger';
            }

            if (remainingSeconds <= 0) {
                alert('Time is up! Your quiz will be automatically submitted.');
                document.getElementById('quizForm').submit();
                return;
            }

            remainingSeconds--;
        }

        // Start the timer
        setInterval(updateTimer, 1000);
        updateTimer();

        function showSubmitConfirmation() {
            // Check for unanswered questions
            let unanswered = [];
            let questionCards = document.querySelectorAll('.question-card');

            questionCards.forEach(function(card, index) {
                let questionNumber = index + 1;
                let radioButtons = card.querySelectorAll('input[type="radio"]');
                let textarea = card.querySelector('textarea');

                if (radioButtons.length > 0) {
                    // Multiple choice question
                    let answered = Array.from(radioButtons).some(radio => radio.checked);
                    if (!answered) {
                        unanswered.push('Question ' + questionNumber + ' (Multiple Choice)');
                    }
                } else if (textarea) {
                    // Short answer question
                    if (!textarea.value.trim()) {
                        unanswered.push('Question ' + questionNumber + ' (Short Answer)');
                    }
                }
            });

            if (unanswered.length > 0) {
                document.getElementById('unansweredQuestions').style.display = 'block';
                let list = document.getElementById('unansweredList');
                list.innerHTML = '';
                unanswered.forEach(function(item) {
                    let li = document.createElement('li');
                    li.textContent = item;
                    list.appendChild(li);
                });
            } else {
                document.getElementById('unansweredQuestions').style.display = 'none';
            }

            new bootstrap.Modal(document.getElementById('submitConfirmModal')).show();
        }

        function submitQuiz() {
            document.getElementById('quizForm').submit();
        }

        // Prevent accidental page refresh/close
        window.addEventListener('beforeunload', function(e) {
            e.preventDefault();
            e.returnValue = '';
        });
    </script>
}

<style>
    .question-card {
        background: #ffffff;
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
    }

        .question-card:hover {
            border-color: var(--mint-medium);
            box-shadow: 0 4px 12px rgba(72, 201, 176, 0.1);
        }

    .question-number {
        color: var(--mint-dark);
        border-bottom: 2px solid var(--mint-light);
        padding-bottom: 10px;
    }

    .form-check-label {
        cursor: pointer;
        padding: 8px 12px;
        margin-left: 8px;
        border-radius: 4px;
        transition: background-color 0.2s;
    }

    .form-check-input:checked + .form-check-label {
        background-color: var(--mint-light);
        color: var(--mint-dark);
        font-weight: 500;
    }

    .quiz-timer {
        font-size: 1.2rem;
    }

    .quiz-info {
        border-left: 4px solid var(--mint-medium);
    }

    textarea.form-control {
        border: 2px solid #e9ecef;
        transition: border-color 0.3s ease;
    }

        textarea.form-control:focus {
            border-color: var(--mint-medium);
            box-shadow: 0 0 0 0.25rem rgba(72, 201, 176, 0.25);
        }
</style>