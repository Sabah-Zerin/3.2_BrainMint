@model List<Brain_Mint.Models.QuizViewModel>
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewBag.Title = "Quiz Participation";
}

<div class="dashboard-card">
    <h2 class="card-title">Available Quizzes</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show">
            @TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Quiz Title</th>
                        <th>Category</th>
                        <th>Difficulty</th>
                        <th>Time Limit</th>
                        <th>Questions</th>
                        <th>Status</th>
                        <th>Score</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <strong>@item.Quiz.Title</strong>
                                @if (!string.IsNullOrEmpty(item.Quiz.Description))
                                {
                                    <br><small class="text-muted">@item.Quiz.Description</small>
                                }
                            </td>
                            <td>
                                <span class="badge bg-secondary">@item.Quiz.Category</span>
                            </td>
                            <td>
                                <span class="badge @(item.Quiz.Difficulty == "Beginner" ? "bg-success" :
                                                   item.Quiz.Difficulty == "Intermediate" ? "bg-warning" : "bg-danger")">
                                    @item.Quiz.Difficulty
                                </span>
                            </td>
                            <td>@item.Quiz.TimeLimit minutes</td>
                            <td>
                                <span class="badge bg-info">
                                    @item.Quiz.Questions.Count questions
                                </span>
                            </td>
                            <td>
                                @if (item.HasAttempted)
                                {
                                    if (item.LastAttempt.GradingStatus == "AutoGraded")
                                    {
                                        <span class="badge bg-success">Completed</span>
                                    }
                                    else if (item.LastAttempt.GradingStatus == "PendingReview")
                                    {
                                        <span class="badge bg-warning text-dark">Under Review</span>
                                    }
                                    else if (item.LastAttempt.GradingStatus == "Reviewed")
                                    {
                                        <span class="badge bg-primary">Reviewed</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark">Not Attempted</span>
                                }
                            </td>
                            <td>
                                @if (item.HasAttempted && item.LastAttempt.PercentageScore.HasValue)
                                {
                                    <span class="badge @(item.LastAttempt.PercentageScore >= 70 ? "bg-success" :
                                                        item.LastAttempt.PercentageScore >= 50 ? "bg-warning" : "bg-danger")">
                                        @item.LastAttempt.PercentageScore.Value.ToString("F1")%
                                    </span>
                                }
                                else if (item.HasAttempted && item.LastAttempt.GradingStatus == "PendingReview")
                                {
                                    <span class="text-muted">Pending</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (item.HasAttempted)
                                {
                                    <a href="@Url.Action("ViewResult", "Quiz", new { attemptId = item.LastAttempt.Id })"
                                       class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-eye"></i> View Result
                                    </a>
                                }
                                else
                                {
                                    <a href="@Url.Action("Take", "Quiz", new { id = item.Quiz.Id })"
                                       class="btn btn-primary btn-sm">
                                        <i class="fas fa-play"></i> Take Quiz
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-clipboard-question fa-3x text-muted mb-3"></i>
            <h5 class="text-muted">No quizzes available</h5>
            <p class="text-muted">Check back later for new quizzes from your teachers.</p>
        </div>
    }
</div>