using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;

namespace Brain_Mint.Views.Quiz
{
	public class Index
	{

@model List<Brain_Mint.Models.Question>

@{
    ViewBag.Title = "Quizzes";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">
        @if (Session["UserRole"]?.ToString() == "Teacher")
        {
            <span>Manage Quizzes</span>
        }
        else
        {
            <span>Available Quizzes</span>
        }
    </h1>

    @if (Session["UserRole"]?.ToString() == "Teacher")
    {
        <a href="/Quiz/Create" class="btn btn-mint">
            <i class="bi bi-plus-circle"></i> Create New
        </a>
    }
</div>

<div class="card">
    <div class="card-body">
        <h2>Quiz</h2>
        <form method="post" action="/Quiz/Submit">
            @for (int i = 0; i < Model.Count; i++)
            {
                <div class="question-card mb-4 p-3 border rounded">
                    <h5>Question @(i+1)</h5>
                    <p class="lead">@Model[i].Text</p>

                    <div class="options-container">
                        @for (int j = 0; j < Model[i].Options.Count; j++)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="answers[@i]" id="q@(i)_o@(j)" value="@j" required>
                                <label class="form-check-label" for="q@(i)_o@(j)">
                                    @Model[i].Options[j]
                                </label>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="text-center mt-4">
                <button type="submit" class="btn btn-mint btn-lg">
                    <i class="bi bi-send"></i> Submit Quiz
                </button>
            </div>
        </form>
    </div>
</div>


	}
}
